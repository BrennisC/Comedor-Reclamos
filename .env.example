# DATABASE_URL: PostgreSQL connection string for Prisma ORM (Neon DB).
# Configure this in your local environment (never commit real credentials).
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# --- Admin Dashboard Authentication ---
# Optional bootstrap admin defined by environment variables.
# Database admins (created from the dashboard) work without these.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Neon Object Storage (S3-compatible) ---
# Credentials for the private bucket used to store WebP evidence images.
AWS_ENDPOINT_URL_S3="https://<endpoint>.storage.<region>.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"

# Bucket name. Defaults to "uploads" when omitted.
NEON_OBJECT_STORAGE_BUCKET="uploads"
