# Copia este archivo a .dev.vars para desarrollo local con Wrangler/OpenNext
# y completa los valores reales (no lo subas con secretos).

# Base de datos (Neon)
DATABASE_URL=

# Sesión de administración
ADMIN_SESSION_SECRET=

# Neon Object Storage (S3 compatible)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
NEON_OBJECT_STORAGE_BUCKET=comedor
